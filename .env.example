# ============================================================
# VARIABLES DE ENTORNO — Sistema Taller de Motos
# ============================================================
# Este archivo es una PLANTILLA (.env.example) — no tiene valores
# reales, solo nombres y comentarios. Copialo a `.env.local` y
# completá los valores ahí. `.env.local` ya está en .gitignore,
# este .env.example SÍ podés subirlo al repo (no tiene secretos).
# ============================================================

# ---- Supabase (tenés estos ya, desde Settings → API) ----
# Estas dos SÍ llevan NEXT_PUBLIC_ porque están pensadas para ser
# visibles en el navegador — la seguridad real la da RLS, no esto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Esta NUNCA lleva NEXT_PUBLIC_. Solo se usa en código server-side
# (Server Actions, funciones que corran en el servidor). Si esta
# key aparece en el navegador (DevTools → Sources) hay una fuga real.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Recuperación de contraseña (apagada por defecto) ----
# El flujo OTP por código exige SMTP propio con template {{ .Token }}
# (el SMTP gratuito de Supabase no permite editar plantillas).
# Taller actual: 2 usuarios, recuperación manual → dejar en false.
NEXT_PUBLIC_ENABLE_PASSWORD_RECOVERY=false
# ---- Resend (solo si se enciende la recuperación — Fase 8) ----
RESEND_API_KEY=
EMAIL_FROM=notificaciones@tudominio.com

# ---- URL del sitio (para links/redirects en los emails de auth) ----
# En desarrollo: http://localhost:3000
# En producción: la URL real una vez desplegado en Netlify
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Rate limiting (Fase 6 — nextjs-hardening) ----
# El rate limiting actual usa memoria en proceso (best-effort en
# serverless). Si querés persistencia entre invocaciones, usá
# Upstash Redis (tiene free tier):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Sentry (monitoreo de errores — Fase 6) ----
# La DSN pública (client) se usa en el navegador; la auth token solo
# en build (subida de source maps). Si la DSN está vacía, el SDK no
# reporta nada (no-op). Crear proyecto en sentry.io → Settings → SDK.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- PWA / Service Worker ----
# Activar para habilitar el service worker (PWA offline).
NEXT_PUBLIC_ENABLE_SW=true
